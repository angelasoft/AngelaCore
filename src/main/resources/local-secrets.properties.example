# 이 파일을 같은 폴더에 local-secrets.properties 로 복사한 뒤 값을 채운다. (Git 제외 대상)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 32바이트 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# 관리자 콘솔 로그인 (해시 생성: htpasswd -bnBC 12 "" '비밀번호' | tr -d ':\n')
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
