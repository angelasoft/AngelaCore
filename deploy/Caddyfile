# AngelaMobile 및 OAuth 콜백용 API
{$API_DOMAIN} {
	encode gzip
	reverse_proxy core:8080
}

# AngelaAdmin: 정적 파일 + 같은 도메인의 /api/* 를 AngelaCore 로 전달(접두사 제거)
{$ADMIN_DOMAIN} {
	encode gzip

	handle_path /api/* {
		reverse_proxy core:8080
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
