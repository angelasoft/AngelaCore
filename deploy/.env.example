# 서버에서 `cp .env.example .env` 후 값을 채운다. (.env 는 Git 제외 대상)
API_DOMAIN=api.angelasoft.com
ADMIN_DOMAIN=admin.angelasoft.com
# Let's Encrypt 인증서 만료 알림 수신 메일
ACME_EMAIL=angelasoft@angelasoft.com

# Lightsail 데이터베이스 > 연결 탭의 엔드포인트
DB_URL=jdbc:postgresql://<엔드포인트>:5432/angelacore?sslmode=require
DB_USERNAME=angela
DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 관리자 권한을 줄 이메일 (콤마 구분)
ADMIN_EMAILS=
